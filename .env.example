# 一般不需要手动编辑：运行 `mimir init` 会把 API Key 写入 ~/.mimir/.env。
#
# 想手动配置时：把需要的行复制到 ~/.mimir/.env（或当前目录的 .env，优先读取），
# 再在 ~/.mimir/config.yaml 的 models 中用 ${变量名} 引用，例如：
#
#   agent:
#     default_model: deepseek
#   models:
#     deepseek:
#       provider: deepseek
#       base_url: https://api.deepseek.com
#       model: deepseek-chat
#       api_key: ${MIMIR_DEEPSEEK_API_KEY}
#
# 变量名格式：MIMIR_<配置名称>_API_KEY（配置名称转成大写，非字母数字的字符换成 _）

MIMIR_OPENAI_API_KEY=""
MIMIR_CLAUDE_API_KEY=""
MIMIR_DEEPSEEK_API_KEY=""
MIMIR_GEMINI_API_KEY=""

# 可选：用户配置和数据目录，默认 ~/.mimir（这一项要设成系统环境变量才生效，写在 .env 里没有用）
# MIMIR_HOME=""
