# 环境变量查找顺序：当前目录/.env -> 项目目录/.env -> 项目上级目录/.env（先找到的优先）

# DeepSeek（OpenAI 兼容接口，如阿里云百炼）
API_KEY="YOUR_API_KEY"
BASE_URL="YOUR_BASE_URL"
MODEL_ID="YOUR_MODEL_ID"
REASONING_DEEPSEEK="high"

# GPT（Responses API）
API_KEY_GPT="YOUR_API_KEY"
BASE_URL_GPT="YOUR_BASE_URL"
MODEL_ID_GPT="YOUR_MODEL_ID"
REASONING_EFFORT="high"

# Claude（Anthropic Messages API；BASE_URL_CLAUDE 留空为官方地址）
API_KEY_CLAUDE="YOUR_API_KEY"
BASE_URL_CLAUDE=""
MODEL_ID_CLAUDE="YOUR_MODEL_ID"
REASONING_CLAUDE="high"

# 通用
TIMEOUT=180
MAX_RETRIES=2
